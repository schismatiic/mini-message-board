<li class="flex justify-between items-center border border-white/20 p-4">
    <div>
        <h3 class="text-xl font-medium">
            <%= username %>
        </h3>
        <p>
            <%= text %>
        </p>
        <p>
            <%= added %>
        </p>
    </div>
    <div class="flex flex-col gap-y-2">
        <a href="/<%= id %>"
            class="bg-white border border-white/20 text-black px-4 py-1 cursor-pointer hover:bg-white/95 active:scale-95">Open</a>
        <a href="/<%= id %>/delete"
            class="bg-black border border-white/20 text-white px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">Delete</a>
    </div>
</li>